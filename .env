# HTTP server configuration
# Precedence: CLI args > real environment > this file > built-in defaults

PORT=8080
# Static file root. Points at the bundled demo site (index.html + CSS + JS).
DOCUMENT_ROOT=www

# CORS: origin echoed in Access-Control-Allow-Origin ("*" allows any origin).
CORS_ALLOW_ORIGIN=*

# Rate limiting: token bucket per client IP. RPS is the sustained refill rate;
# BURST is the bucket size (the largest instantaneous burst allowed). Set
# RATE_LIMIT_ENABLED=false to turn it off.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# API key auth: comma-separated list of accepted keys. When empty, auth is
# disabled and every route is open. When set, mutating requests (POST/PUT/
# DELETE/PATCH) must present a key via "X-API-Key: <key>" or
# "Authorization: Bearer <key>"; reads stay public. Leave empty for the demo.
API_KEYS=

# TLS
SSL_ENABLED=true
SSL_CERT_FILE=server.crt
SSL_KEY_FILE=server.key

# PROXY protocol. The balancer is a byte pump, so without this the backend
# sees every request coming from the balancer's own address: per-client rate
# limiting collapses into one bucket and the access log says the same thing for
# everyone. With PROXY_PROTOCOL on, the balancer prefixes each backend
# connection with a PROXY v1 header naming the real client, and the backend
# adopts it when TRUST_PROXY_PROTOCOL is on.
#
# Only enable TRUST_PROXY_PROTOCOL when the server's port is reachable solely
# by the balancer: the header lets whoever sends it claim any source address.
# When it is on the header is mandatory, so a direct connection is refused.
TRUST_PROXY_PROTOCOL=false

# Load balancer (codo-balancer)
# BALANCER_PORT      listen port for the balancer
# BALANCER_BACKENDS  comma-separated backend list: host:port[:weight]
#                    (IPv4 literals, IPv6 literals and DNS names all work)
# PROXY_PROTOCOL     send a PROXY v1 header to backends (see above)
BALANCER_PORT=8000
BALANCER_BACKENDS=127.0.0.1:8080
PROXY_PROTOCOL=false
